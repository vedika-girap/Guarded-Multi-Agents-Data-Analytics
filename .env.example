# CHANGE HERE: Replace the demo secret and Gemini placeholder before starting a shared demo.
APP_ENV=staging
DEMO_MODE=true
# Demo personas authenticate with the short-lived token endpoint. Outside demo mode, dev remains the local fixed viewer.
AUTH_MODE=dev
JWT_SECRET=<32+ byte random>

# SUPPLY KEY HERE: Use a demo-only Gemini key; retrieval and reviewed templates still work without it.
GEMINI_API_KEY=<demo-only key>
# Gemini model used by the Interactions API. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Gemini embedding model used by the optional Chroma semantic index.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Maximum generated tokens per model call; demo mode clamps output to DEMO_MAX_OUTPUT_TOKENS.
LLM_MAX_OUTPUT_TOKENS=256

# CHANGE HERE: Demo-mode limits apply per client IP and signed token in this process.
DEMO_REQUESTS_PER_MINUTE=10
# Maximum characters in a demo question.
DEMO_MAX_QUESTION_LENGTH=400
# Hard cap on SQL result rows in demo mode.
DEMO_MAX_ROWS=25
# Gemini HTTP timeout in demo mode, in seconds.
DEMO_REQUEST_TIMEOUT_SECONDS=10
# Maximum generated tokens in demo mode.
DEMO_MAX_OUTPUT_TOKENS=256

# SQLite demo database by default. Set to postgresql://... to use PostgreSQL.
DATABASE_URL=sqlite:///data/demo.db
# >>> ACTION REQUIRED (Stage 2): Set a PostgreSQL owner/admin URL before running Alembic migrations.
# See README section "PostgreSQL local testing".
MIGRATION_DATABASE_URL=
# PostgreSQL per-query timeout. SQLite uses its progress-handler fallback.
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Minimum number of records required in a viewer aggregate cell.
VIEWER_MIN_GROUP_SIZE=3

# >>> ACTION REQUIRED (Stage 2): Set this local admin password before starting the PostgreSQL compose service.
# See README section "PostgreSQL local testing".
POSTGRES_PASSWORD=
# >>> ACTION REQUIRED (Stage 2): Set a distinct password for the read-only app role.
# See README section "PostgreSQL local testing".
APP_DB_PASSWORD=

# Existing JWT deployments may continue using AUTH_JWT_SECRET; JWT_SECRET is the demo alias.
AUTH_JWT_SECRET=
# >>> ACTION REQUIRED (Stage 1): Set the exact issuer configured by your trusted identity provider.
# See README section "Setup checklist".
AUTH_JWT_ISSUER=
# >>> ACTION REQUIRED (Stage 1): Set the API audience configured by your trusted identity provider.
# See README section "Setup checklist".
AUTH_JWT_AUDIENCE=

# Per-user requests allowed in a rolling minute in development.
DEV_RATE_LIMIT_PER_MINUTE=120
# Per-user requests allowed in a rolling minute in staging.
STAGING_RATE_LIMIT_PER_MINUTE=60
# Per-user requests allowed in a rolling minute in production.
PRODUCTION_RATE_LIMIT_PER_MINUTE=30
# Optional shared sliding-window limiter. Required when ENVIRONMENT=production.
# For the optional local Compose service use redis://localhost:6379/0.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.5
# Maximum question tokens allowed per request in development.
DEV_MAX_QUESTION_TOKENS=4096
# Maximum question tokens allowed per request in staging.
STAGING_MAX_QUESTION_TOKENS=2048
# Maximum question tokens allowed per request in production.
PRODUCTION_MAX_QUESTION_TOKENS=2048
